# MongoDB connection string (local development)
MONGODB_URI=mongodb://127.0.0.1:27017/finvault?retryWrites=false

# JWT signing secret (use a long random string in production)
JWT_SECRET=your-long-random-secret-here

# Optional token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Public app origin (invite links, emails). No trailing slash.
APP_URL=http://localhost:3000

# Transactional email (guest invites). If SMTP_* is unset, invites still save
# and the invite URL is logged in development only.
EMAIL_FROM=FinVault <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional later alternative to SMTP (not required for Phase 3.4)
# RESEND_API_KEY=

# Display FX (PKR per 1 USD / EUR). Used for display only — ledger stays PKR.
# FX_USD_PKR=278.5
# FX_EUR_PKR=300

# Dev-only GET /api/admin/audit (always disabled in production)
# ENABLE_ADMIN_AUDIT=true
